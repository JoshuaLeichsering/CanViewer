{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanViewer",
  "version": "../package.json",
  "identifier": "io.github.joshualeichsering.canviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CanViewer",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "The CanViewer authors",
    "copyright": "Copyright (C) 2026 The CanViewer authors",
    "license": "GPL-2.0-or-later",
    "licenseFile": "../COPYRIGHT",
    "shortDescription": "A viewer for CAN database files",
    "longDescription": "CanViewer shows CAN databases: DBC files, and ARXML, KCD and the other formats canmatrix reads. It decodes and encodes frames, replays candump and Vector ASC logs, compares two versions of a database, and saves edits as DBC. Everything runs on this computer, offline.",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/can-viewer/copyright": "../COPYRIGHT"
        }
      }
    }
  }
}
