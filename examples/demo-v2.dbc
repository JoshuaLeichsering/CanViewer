VAL_ 512 GearPosition 15 "Reverse" 0 "Neutral" 1 "Gear 1" 2 "Gear 2" 3 "Gear 3" 4 "Gear 4" 5 "Gear 5" 6 "Gear 6" 7 "Gear 7" ;
VAL_ 256 EngineRunning 0 "Stopped" 1 "Running" ;
VAL_ 768 AbsActive 0 "Inactive" 1 "Active" ;
VAL_ 1024 ErrorCode 0 "No error" 1 "Sensor short to ground" 2 "Sensor short to battery" 3 "Sensor open circuit" ;

SIG_VALTYPE_ 1280 BatteryVoltage : 1;

SG_MUL_VAL_ 1024 ErrorCode MuxSelector 2-2;
