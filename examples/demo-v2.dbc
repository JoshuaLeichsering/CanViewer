 SG_ HeadlightsOn : 4|1@1+ (1,0) [0|1] ""  IC

BO_TX_BU_ 512 : TCM,ECM;

CM_ "CanViewer demo database with typical powertrain messages.";
CM_ BU_ ECM "Engine Control Module";
CM_ BU_ TCM "Transmission Control Module";
CM_ BU_ ABS "Anti-lock Braking System";
CM_ BU_ IC "Instrument Cluster";
CM_ BU_ BCM "Body Control Module";
CM_ BO_ 256 "Engine status broadcast, 10 ms cycle.";
CM_ SG_ 256 EngineSpeed "Crankshaft rotational speed, filtered.";
CM_ BO_ 1024 "Diagnostic data message.
Second line of this comment.";
CM_ SG_ 768 BrakePressure "Master cylinder pressure.";
CM_ BO_ 1536 "ADAS object list broadcast (CAN FD, 24-byte payload).";
CM_ BO_ 1792 "Door and light status.";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 10000;
BA_DEF_ BO_ "GenMsgSendType" ENUM "Cyclic","Event","IfActive","NoMsgSendType";
