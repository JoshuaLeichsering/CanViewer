{
  "name": "canviewer",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-wheels.mjs --quiet",
    "dev": "vite",
    "prebuild": "node scripts/fetch-wheels.mjs --quiet",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/fetch-wheels.mjs --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-wheels": "node scripts/fetch-wheels.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "notices": "node scripts/third-party-notices.mjs",
    "check:licenses": "node scripts/check-spdx-headers.mjs && node scripts/check-licenses.mjs",
    "check:identifying-info": "node scripts/check-identifying-info.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "pyodide": "314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
