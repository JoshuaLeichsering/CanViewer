{
  "name": "canviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-wheels.mjs --quiet",
    "dev": "vite",
    "prebuild": "node scripts/fetch-wheels.mjs --quiet",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/fetch-wheels.mjs --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/fetch-wheels.mjs --quiet",
    "test:coverage": "vitest run --coverage",
    "e2e": "tsc --noEmit -p e2e && playwright test",
    "fetch-wheels": "node scripts/fetch-wheels.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "pyodide": "314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
